# Shared CI build parameters, loaded into the job environment by the load-ci-parameters action.
# Kept out of the workflow files so the module/flavor/output details live in one place.
#
# Only genuinely shared values belong here. Anything AGP composes from a flavor name (task names,
# output directories, artifact file names) is derived by the resolve-artifact-names action instead,
# because a second copy of a derivable value is a copy that can disagree.
#
# A parameter left EMPTY makes its step skip rather than fail, which is what lets the same workflow
# set serve a repository that has not adopted that step yet.

APP_NAME=TemplateProject
KEYSTORE_FILE_NAME=TemplateProject.jks

# The flavor CI treats as representative. Unit tests, lint and the instrumented suite run against
# this one; a release builds every flavor listed in the release workflow's matrix.
DEFAULT_FLAVOR=flavor1

GRADLE_TASK_UNIT_TEST=testFlavor1DebugUnitTest
GRADLE_TASK_LINT=:app:lintFlavor1Debug
# Detekt is a root task deliberately not wired into `check` (see the root build.gradle.kts), so it
# would never run in CI unless it is invoked by name. Empty to skip it.
GRADLE_TASK_STATIC_ANALYSIS=detekt
GRADLE_TASK_INSTRUMENTED_TEST=:app:connectedFlavor1DebugAndroidTest

# Release artifact size ceilings. They exist to catch a runaway (an accidentally bundled asset, a
# shrinker that stopped shrinking), not to police normal growth, so raise them deliberately rather
# than reflexively when a release legitimately grows into one. Empty means report without failing.
MAX_RELEASE_APK_MB=25
MAX_RELEASE_AAB_MB=30
