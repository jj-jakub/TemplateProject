%% The module graph, and the direction dependencies are allowed to point.
%% Enforced by the Konsist architecture tests in app/src/test/java/konsist/KonsistTests.kt:
%% domain depends on nothing, data depends on domain, presentation depends on domain and data.
%% All modules except :app are genuine Kotlin Multiplatform modules (Android + iOS); iosApp is a
%% Swift/Xcode project outside Gradle entirely, generated by xcodegen from iosApp/project.yml.
graph TD
    iosApp["iosApp<br/>Swift · xcodegen-generated"]
    app[":app<br/>Android shell: DI wiring, framework entry points"]
    presentation[":presentation<br/>screens, ViewModels, navigation, DI (own)<br/>KMP + Compose Multiplatform"]
    design[":design<br/>theme, tokens, components<br/>Compose Multiplatform"]
    core[":core<br/>platform implementations<br/>KMP"]
    networking[":networking<br/>Ktor services, repositories<br/>KMP"]
    domain[":domain<br/>use cases, interfaces, pure logic<br/>KMP"]

    iosApp --> presentation
    app --> presentation
    app --> design
    app --> core
    app --> networking
    app --> domain
    presentation --> design
    presentation --> core
    presentation --> networking
    presentation --> domain
    core --> domain
    networking --> domain

    classDef pure fill:#e8f0fe,stroke:#1a73e8,stroke-width:2px
    class domain pure
    classDef swift fill:#fff3e0,stroke:#e65100,stroke-width:2px
    class iosApp swift
